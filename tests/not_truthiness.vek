// Truthiness tests for the 'not' operator and if-conditions.
// Rules: false, 0 (int32/int64/float/double), '\0', "" and null/empty arrays
// are falsy; everything else is truthy.
func main() int {
    // bool
    print(not true);      // false
    print(not false);     // true

    // int32
    let int32 z = 0;
    let int32 n = 5;
    print(not z);         // true
    print(not n);         // false

    // int64
    let int64 big = 0;
    print(not big);       // true

    // float32 / float64
    let float32 fz = (float32)(0.0);
    let float32 fn = (float32)(2.5);
    print(not fz);        // true
    print(not fn);        // false
    let float64 dz = 0.0;
    print(not dz);        // true

    // str: empty string is falsy, non-empty is truthy
    let str empty = "";
    let str text = "x";
    print(not empty);     // true
    print(not text);      // false

    // char: '\0' is falsy
    let char nul = '\0';
    let char c = 'a';
    print(not nul);       // true
    print(not c);         // false

    // arrays: null or empty array is falsy
    let int32 e[] = {};
    let int32 a[] = {1, 2};
    print(not e);         // true
    print(not a);         // false

    // if-conditions use the same truthiness rules
    if ("") { print("bad-empty-str"); } else { print("empty-str-falsy"); }
    if (0.0) { print("bad-zero-double"); } else { print("zero-double-falsy"); }
    if (1.5) { print("nonzero-double-truthy"); }
    if (true) { print("bool-true-truthy"); }
    if (1) { print("int-one-truthy"); }

    ret 0;
}
