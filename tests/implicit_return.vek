// Functions without an explicit 'ret' must return implicitly (default value 0,
// same as a bare 'ret;') instead of falling through into the next compiled
// function's bytecode.
func first() int { print("first"); }
func second() int { print("second"); }

// A body ending in if/else where both branches return already ends with an
// OP_RETURN on every path, so no implicit return is appended.
func classify(int x) int {
    if (x > 0) { ret 1; } else { ret 2; }
}

// Void function with no 'ret' at all.
func log_it(str msg) void {
    print(msg);
}

func main() int {
    first();
    second();
    print(classify(5));
    print(classify(-5));
    log_it("void-ok");
    print("done");
    ret 0;
}
