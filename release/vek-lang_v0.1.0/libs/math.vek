# Math.vek
# Standard Math Library for VekLang

// Constants
const float64 PI = 3.141592653589793;
const float64 E = 2.718281828459045;
const float64 TAU = 6.283185307179586; // PI * 2

// Physics / General Math
const float64 INF = 1.0 / 0.0; // Infinity
const float64 NAN = 0.0 / 0.0; // Not A Number

// Rounding
func floor(float num) int {
    let int truncated = (int)num;
    if (num < 0.0 && num != (float)truncated) {
        ret truncated - 1;
    }
    ret truncated;
}

func ceil(float num) int {
    let int truncated = (int)num;
    if (num > 0.0 && num != (float)truncated) {
        ret truncated + 1;
    }
    ret truncated;
}

func round(float num) int {
    if (num < 0.0) {
        ret ceil(num - 0.5);
    }
    ret floor(num + 0.5);
}

// Basic Math
func abs(int num) int {
    if (num < 0) {
        ret -num;
    }
    ret num;
}

func fabs(float64 num) float64 {
    if (num < 0.0) {
        ret -num;
    }
    ret num;
}

func min(int a, int b) int {
    if (a < b) { ret a; }
    ret b;
}

func max(int a, int b) int {
    if (a > b) { ret a; }
    ret b;
}

func fmin(float64 a, float64 b) float64 {
    if (a < b) { ret a; }
    ret b;
}

func fmax(float64 a, float64 b) float64 {
    if (a > b) { ret a; }
    ret b;
}

func clamp(int val, int min_val, int max_val) int {
    if (val < min_val) { ret min_val; }
    if (val > max_val) { ret max_val; }
    ret val;
}

func fclamp(float64 val, float64 min_val, float64 max_val) float64 {
    if (val < min_val) { ret min_val; }
    if (val > max_val) { ret max_val; }
    ret val;
}

func sign(int num) int {
    if (num > 0) { ret 1; }
    if (num < 0) { ret -1; }
    ret 0;
}

func lerp(float64 a, float64 b, float64 t) float64 {
    ret a + (b - a) * t;
}

// Parity
func is_even(int num) bool {
    ret mod(num, 2) == 0;
}

func is_odd(int num) bool {
    ret mod(num, 2) != 0;
}

// Power & Square Root
func pow(int num, int power) int {
    if (power < 0) { ret 0; }
    let int result = 1;
    for (let int i = 0; i < power; i += 1) {
        result = result * num;
    }
    ret result;
}

func sqrt(int num) int {
    if (num < 0) { ret -1; }
    if (num == 0) { ret 0; }

    let int x = num;
    let int y = (x + 1) / 2;

    // Newton iteration
    while (y < x) {
        x = y;
        y = (x + num / x) / 2;
    }
    ret x;
}

func mod(int a, int b) int {
    ret a - (a / b) * b;
}
